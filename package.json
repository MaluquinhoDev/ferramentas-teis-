{
  "name": "quadra-hq",
  "version": "0.2.0",
  "private": true,
  "description": "Quadra — estúdio móvel de HQ digital",
  "scripts": {
    "prepare:web": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});fs.mkdirSync('dist');for(const f of ['index.html','styles.css','app.js','quests.css','quests.js','manifest.webmanifest','icon.svg','sw.js'])fs.copyFileSync(f,'dist/'+f)\"",
    "android:sync": "npm run prepare:web && cap sync android",
    "android:build": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3"
  }
}